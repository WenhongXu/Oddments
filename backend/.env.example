# ──────────────────────────────────────────────
# 守明 后端配置
# 复制本文件为 .env，填入实际值
# ──────────────────────────────────────────────

PORT=3001
FRONTEND_URL=http://localhost:5173

# 会话密钥（务必修改为随机长字符串）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string


# ──────────────────────────────────────────────
# AI 提供商配置
# 选择其中一种，注释掉其他的
# ──────────────────────────────────────────────

# ── 方案A：Anthropic Claude（境外/有梯子时使用）──
AI_PROVIDER=anthropic
AI_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# AI_MODEL=claude-sonnet-4-6          # 可选，默认 claude-sonnet-4-6

# ── 方案B：DeepSeek（推荐，性价比最高，中国大陆直接访问）──
# AI_PROVIDER=deepseek
# AI_API_KEY=sk-xxxxxxxxxxxxxxxx
# AI_MODEL=deepseek-chat              # 或 deepseek-reasoner (R1)
# AI_BASE_URL=https://api.deepseek.com/v1

# ── 方案C：通义千问 Qwen（阿里云，中国大陆）──
# AI_PROVIDER=qwen
# AI_API_KEY=sk-xxxxxxxxxxxxxxxx      # DashScope API Key
# AI_MODEL=qwen-plus                  # 或 qwen-max / qwen-turbo
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 方案D：豆包 Doubao（字节跳动，中国大陆）──
# AI_PROVIDER=doubao
# AI_API_KEY=xxxxxxxxxxxxxxxx
# AI_MODEL=ep-xxxxxxxx-xxxxx         # 你的推理接入点 ID（在控制台创建）
# AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ── 方案E：智谱 GLM（中国大陆）──
# AI_PROVIDER=zhipu
# AI_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
# AI_MODEL=glm-4-flash               # 或 glm-4-plus / glm-4
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── 方案F：Ollama 本地部署（完全离线，Mac mini 本机运行）──
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b                 # 或 deepseek-r1:7b / llama3.2:3b
# AI_BASE_URL=http://localhost:11434/v1
# （不需要 AI_API_KEY）

# ── 方案G：其他 OpenAI 兼容 API ──
# AI_PROVIDER=openai_compat
# AI_API_KEY=your-key
# AI_MODEL=your-model-name
# AI_BASE_URL=https://your-api-endpoint/v1

# 最大 token 数（可选，默认 1500）
# AI_MAX_TOKENS=1500
